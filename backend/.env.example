# Copy to .env for local development. Do not commit actual secrets.

# Runtime
NODE_ENV=development
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=logtool
DB_USER=logtool
DB_PASSWORD=replace-me

# Cache / Redis (required for local-login protection when it is enabled)
CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
AUTH_LOCAL_LOGIN_ENABLED=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_REMEMBER_TTL=30d
REFRESH_COOKIE_NAME=rt
CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_LOGIN_CAPTCHA_THRESHOLD=3
AUTH_LOGIN_LOCK_THRESHOLD=5
AUTH_LOGIN_LOCK_TTL_SECONDS=900
REFRESH_TOKEN_CLEANUP_DISABLED=false
REFRESH_TOKEN_CLEANUP_INTERVAL_MIN=60
REFRESH_TOKEN_CLEANUP_STARTUP_DELAY_SEC=45
REFRESH_TOKEN_REVOKED_RETENTION_DAYS=30

# DingTalk internal application / password-free login
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# DingTalk web QR login (configure only after the QR adapter is implemented)
DINGTALK_WEB_CLIENT_ID=
DINGTALK_WEB_CLIENT_SECRET=
DINGTALK_WEB_REDIRECT_URI=
DINGTALK_QR_SESSION_TTL_SECONDS=300
