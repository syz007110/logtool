{
  "registryVersion": "v1",
  "tools": [
    {
      "toolName": "device_context_lookup",
      "displayName": "设备解析",
      "enabled": true,
      "description": "将用户输入的设备编号、设备型号或系列线索解析成标准化设备名片，供故障码、日志、手术数据等后续工具复用，能够查询设备编号、设备密钥、设备型号、设备系列等信息。",
      "descriptionFile": "./descriptions/device_context_lookup.md",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "queryType": {
            "type": "string",
            "enum": [
              "device_id",
              "device_model",
              "series",
              "decrypt_key"
            ],
            "description": "查询方式。device_id 表示按设备编号解析，device_model 表示按设备型号解析，series 表示按标准系列码解析，decrypt_key 表示按密钥反查设备名片。"
          },
          "deviceId": {
            "type": "string",
            "description": "queryType=device_id 时填写。设备编号原始输入，例如 4371-28、4339-XXX、SR4339-2509009。后端会先做规则归一化。",
            "minLength": 1,
            "maxLength": 100
          },
          "deviceModel": {
            "type": "string",
            "description": "queryType=device_model 时填写。设备型号名称，例如 4336。用于识别所属设备系列。",
            "minLength": 1,
            "maxLength": 100
          },
          "seriesCode": {
            "type": "string",
            "enum": [
              "SR",
              "SA"
            ],
            "description": "queryType=series 时填写。标准系列码。SR 表示 Tumai / 多臂 / 四臂腹腔镜手术机器人；SA 表示 Tumai SP / 单孔 / 单孔腹腔镜手术机器人。"
          },
          "decryptKey": {
            "type": "string",
            "description": "queryType=decrypt_key 时填写。日志解密密钥，格式为 MAC 地址，例如 00-01-05-a9-40-dc。",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$"
          },
          "strict": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "description": "是否启用严格模式。true 表示存在歧义时直接返回候选，不做规则兜底；false 表示允许有限规则推断。"
          },
          "language": {
            "type": "string",
            "enum": [
              "zh-CN",
              "en-US"
            ],
            "description": "返回文案语言。"
          }
        },
        "required": [
          "queryType"
        ]
      },
      "runtime": {
        "defaults": {
          "strict": "false",
          "language": "zh-CN"
        },
        "execution": {
          "mode": "sync",
          "handler": "deviceContextLookupHandler.execute",
          "timeoutMs": 5000,
          "retryable": false
        }
      },
      "security": {
        "riskLevel": "low",
        "requiredPermissions": [
          "device:read"
        ],
        "permissionBypassChannels": [
          "dingtalk"
        ],
        "audit": true
      }
    }
  ]
}
